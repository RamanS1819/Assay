# Copy to .env and fill in. .env is gitignored — never commit a real testnet key
# into a public repo. All services here have a free tier; if any asks for a card,
# it is the wrong service.

# --- The Graph (free: 100k queries/mo) ---
GRAPH_API_KEY=
GRAPH_LENDING_SUBGRAPH_URL=      # Messari standardized lending subgraph (mainnet)
GRAPH_TOKEN_API_URL=             # Token API (balances / portfolio)

# --- Hedera testnet (free faucet) ---
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=              # testnet only, still never committed (contract deployer)
HEDERA_RPC_URL=                  # JSON-RPC relay, e.g. https://testnet.hashio.io/api
AGENT_WALLET_ADDRESS=            # the agent's Privy wallet — issuer/revoker on the credit token
CREDIT_TOKEN_ADDRESS=            # deployed CreditToken address (from contracts deploy)

# --- x402 / Blocky402 (free, no API key) ---
BLOCKY402_FACILITATOR_URL=       # testnet facilitator, e.g. https://api.testnet.blocky402.com
X402_ASSET=0.0.0                 # native HBAR = 0.0.0 (an HTS token would be its 0.0.x id)
X402_PAY_TO=                     # service account that receives x402 payments (a Hedera 0.0.x)
X402_FEE_PAYER=0.0.7162784       # Blocky402 facilitator account (pays gas); from GET /supported

# --- Privy (free Developer tier, no card) ---
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_KEY=         # backend key that owns the agent wallet
PRIVY_WALLET_ID=

# --- LLM (free) ---
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=groq                # groq | gemini | ollama

# --- Database (Neon free tier) ---
DATABASE_URL=
